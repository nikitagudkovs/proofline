{
  "name": "proofline",
  "version": "0.1.0",
  "description": "Contract-first orchestrator for coding agents: every requirement gets a proof, and nothing is done until the proof passes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "proofline": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/ui",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p . && tsc -p ui && vite build --config ui/vite.config.ts",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "agents",
    "orchestrator",
    "claude-code",
    "prd",
    "acceptance-criteria",
    "verification"
  ],
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21"
  }
}
